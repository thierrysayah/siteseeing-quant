{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnUserObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::estimation-platform-user-data/private/users/${aws:PrincipalTag/sub}/*"
    },
    {
      "Sid": "OwnOrgObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload"],
      "Resource": [
        "arn:aws:s3:::estimation-platform-user-data/private/organisations/org-${aws:PrincipalTag/orgId}/*",
        "arn:aws:s3:::estimation-platform-user-data/private/org-${aws:PrincipalTag/orgId}/*"
      ]
    },
    {
      "Sid": "ListOwnPrefixesOnly",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketMultipartUploads"],
      "Resource": "arn:aws:s3:::estimation-platform-user-data",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "private/users/${aws:PrincipalTag/sub}/*",
            "private/organisations/org-${aws:PrincipalTag/orgId}/*",
            "private/org-${aws:PrincipalTag/orgId}/*"
          ]
        }
      }
    }
  ]
}
